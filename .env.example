# --- Vercel deploy (Phase 8) ---
# 1. Import repo in Vercel (or `npx vercel link`).
# 2. Add env vars below in Project → Settings → Environment Variables.
# 3. Attach Vercel KV (Upstash) for /api/push and cron de-dupe.
# 4. Deploy production (`vercel --prod`). HTTPS is required for clipboard (M3) and web push.
# 5. Cron schedules live in vercel.json (08:00 and 18:00 IST windows).
# Manual before ship: edge case §10 on Android Chrome; tick M1–M5 and N6–N8 on device.

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron auth (set in Vercel project env)
CRON_SECRET=

# Vercel KV / Upstash (push subscriptions + reminder de-dupe)
KV_REST_API_URL=
KV_REST_API_TOKEN=
