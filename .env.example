# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron auth (set in Vercel project env)
CRON_SECRET=

# Vercel KV / Upstash (push subscriptions + reminder de-dupe)
KV_REST_API_URL=
KV_REST_API_TOKEN=
